---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.svelte';
import { ISSUES } from '../data/issues';
import { latestIssues } from '../lib/rss';
import { formatIssueDate, publishedDay } from '../lib/issue-meta';

const title = 'Page not found — FORA';
const description = 'This page or issue could not be found. Search the issues or pick one of the latest from FORA.';

// S-7: give a reader who hit a dead link somewhere to go. The five newest
// issues are server-rendered; search runs on the same index as the app.
const latest = latestIssues(ISSUES, 5);
// Headlines for search results (the search index stores ids only). Data
// block, not executed, so it needs no CSP hash.
const searchTitles = JSON.stringify(latestIssues(ISSUES).map((issue) => [issue.id, issue.headline]))
  .replace(/[<>&]/g, (c) => `\\u${c.charCodeAt(0).toString(16).padStart(4, '0')}`);
---

<Base {title} {description}>
  <header style="display:flex;align-items:center;justify-content:space-between;padding:16px 18px;border-bottom:1px solid var(--border-subtle);background:var(--bg);">
    <a href="/" style="display:inline-flex;align-items:center;gap:12px;text-decoration:none;color:var(--text-primary);min-height:44px;">
      <Logo size={60} />
      <span style="font-family:var(--font-display);font-size: var(--text-body-lg);font-weight:700;letter-spacing:-0.02em;color:var(--text-primary);">FORA</span>
    </a>
    <a href="/about" style="display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 14px;border-radius: var(--radius-pill);border:1px solid var(--border-subtle);background:var(--bg-elevated);font-size: var(--text-sm);font-weight:700;color:var(--text-secondary);text-decoration:none;">How This Works</a>
  </header>
  <main class="nf">
    <section class="nf-lead">
      <p class="nf-kicker">404</p>
      <h1 class="nf-title">This page wasn’t found.</h1>
      <p class="nf-copy">
        The issue may have moved, the link may be incomplete, or the route may no longer exist. Search the issues, pick one of the latest below, or return to Today.
      </p>

      <form class="nf-search" role="search" aria-label="Search issues" data-nf-search hidden>
        <label class="sr-only" for="nf-query">Search issues</label>
        <input id="nf-query" name="q" type="search" placeholder="Search issues" autocomplete="off" data-nf-query />
        <button type="submit">Search</button>
      </form>
      <p class="nf-status" role="status" aria-live="polite" data-nf-status></p>
      <ul class="nf-results" data-nf-results></ul>

      <a class="nf-home" href="/">Return to Today</a>
    </section>

    <section class="nf-latest" aria-labelledby="nf-latest-heading">
      <h2 id="nf-latest-heading">Latest issues</h2>
      <ol>
        {latest.map((issue) => (
          <li>
            <a href={`/issue/${issue.id}`}>{issue.headline}</a>
            {publishedDay(issue) && <time datetime={publishedDay(issue)}>{formatIssueDate(publishedDay(issue))}</time>}
          </li>
        ))}
      </ol>
      <p class="nf-feed"><a href="/rss.xml">Follow new issues by RSS</a></p>
    </section>
  </main>

  <script type="application/json" id="nf-issue-titles" is:inline set:html={searchTitles}></script>

  <script>
    import { loadSearchIndex, search } from '../lib/search';

    const form = document.querySelector<HTMLFormElement>('[data-nf-search]');
    const input = document.querySelector<HTMLInputElement>('[data-nf-query]');
    const status = document.querySelector<HTMLElement>('[data-nf-status]');
    const results = document.querySelector<HTMLUListElement>('[data-nf-results]');
    const titlesEl = document.getElementById('nf-issue-titles');

    if (form && input && status && results && titlesEl) {
      const titles = new Map<string, string>(JSON.parse(titlesEl.textContent || '[]'));
      // Search needs JavaScript, so the form only appears when it can work.
      form.hidden = false;

      const run = async () => {
        const query = input.value.trim();
        results.replaceChildren();
        if (query.length < 2) {
          status.textContent = query ? 'Type at least two letters.' : '';
          return;
        }
        status.textContent = 'Searching…';
        await loadSearchIndex();
        const ids = search(query).filter((id) => titles.has(id)).slice(0, 8);
        if (input.value.trim() !== query) return;
        for (const id of ids) {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `/issue/${id}`;
          a.textContent = titles.get(id) ?? id;
          li.append(a);
          results.append(li);
        }
        status.textContent = ids.length
          ? `${ids.length} ${ids.length === 1 ? 'issue matches' : 'issues match'} “${query}”.`
          : `No issues match “${query}”. Try another word.`;
      };

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        void run();
      });
      // Start fetching the index as soon as the reader shows intent.
      input.addEventListener('focus', () => { void loadSearchIndex(); }, { once: true });
    }
  </script>

  <style>
    .nf {
      min-height: calc(100vh - 77px);
      min-height: calc(100dvh - 77px);
      padding: 40px 20px 56px;
      background:
        radial-gradient(circle at top right, rgba(210, 140, 40, 0.08), transparent 28%),
        linear-gradient(180deg, var(--bg-elevated) 0%, var(--bg) 22%, var(--bg) 100%);
    }

    .nf-lead,
    .nf-latest {
      max-width: 560px;
      margin: 0 auto;
    }

    .nf-lead {
      text-align: center;
    }

    .nf-kicker {
      margin: 0;
      font-size: var(--text-xs);
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-tertiary);
    }

    .nf-title {
      margin: 12px 0 0;
      font-family: var(--font-display);
      font-size: var(--text-error-title-fluid);
      line-height: 0.98;
      letter-spacing: -0.05em;
      color: var(--text-primary);
    }

    .nf-copy {
      margin: 16px 0 0;
      font-size: var(--text-body);
      line-height: 1.7;
      color: var(--text-secondary);
    }

    .nf-search {
      display: flex;
      gap: 8px;
      margin: 24px 0 0;
    }

    .nf-search[hidden] {
      display: none;
    }

    .nf-search input {
      flex: 1;
      min-width: 0;
      min-height: 48px;
      padding: 0 16px;
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      background: var(--bg-sunken);
      color: var(--text-primary);
      font: inherit;
      font-size: var(--text-body);
    }

    .nf-search button,
    .nf-home {
      min-height: 48px;
      padding: 0 20px;
      border-radius: var(--radius-pill);
      font: inherit;
      font-size: var(--text-ui);
      font-weight: 700;
      cursor: pointer;
    }

    .nf-search button {
      border: none;
      background: var(--text-primary);
      color: var(--bg);
    }

    .nf-status {
      margin: 12px 0 0;
      font-size: var(--text-sm);
      color: var(--text-secondary);
    }

    .nf-status:empty {
      margin: 0;
    }

    .nf-results {
      list-style: none;
      margin: 8px 0 0;
      padding: 0;
      text-align: left;
    }

    .nf-results :global(li) {
      border-top: 1px solid var(--border-subtle);
    }

    .nf-results :global(a) {
      display: block;
      padding: 12px 4px;
      color: var(--text-primary);
      font-weight: 600;
      line-height: 1.4;
      text-decoration: none;
    }

    .nf-home {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: 24px;
      border: 1px solid rgba(184, 92, 0, 0.28);
      background: rgba(210, 140, 40, 0.12);
      color: var(--score-warning);
      text-decoration: none;
      letter-spacing: 0.01em;
    }

    .nf-latest {
      margin-top: 48px;
    }

    .nf-latest h2 {
      margin: 0 0 8px;
      font-family: var(--font-display);
      font-size: var(--text-xs);
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-tertiary);
    }

    .nf-latest ol {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .nf-latest li {
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding: 12px 0;
      border-top: 1px solid var(--border-subtle);
    }

    .nf-latest a {
      color: var(--text-primary);
      font-weight: 600;
      line-height: 1.4;
      text-decoration: none;
    }

    .nf-latest time {
      font-size: var(--text-sm);
      color: var(--text-tertiary);
    }

    .nf-feed {
      margin: 16px 0 0;
      font-size: var(--text-sm);
    }

    .nf-feed a {
      color: var(--text-secondary);
      text-decoration: underline;
      text-underline-offset: 2px;
      font-weight: 600;
    }

    @media (hover: hover) {
      .nf-latest a:hover,
      .nf-results :global(a:hover) {
        text-decoration: underline;
      }
    }

  .nf { max-width:1000px; }
  .nf-kicker { color:var(--fora-brand); }
  .nf-title { font-family:var(--fora-serif); letter-spacing:-.02em; }
  .nf-home { background:var(--fora-brand); color:var(--fora-surface); }

</style>
</Base>
