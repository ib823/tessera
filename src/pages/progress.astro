---
import Base from '../layouts/Base.astro';
import UtilityHeader from '../components/UtilityHeader.astro';
import ReadingProgressPanel from '../components/ReadingProgressPanel.svelte';
import UtilityFooter from '../components/UtilityFooter.astro';
---
<Base title="Reading progress — FORA" description="Export, import, or clear your reading progress on this device.">
  <UtilityHeader />
  <main style="max-width: 560px; margin: 0 auto; padding: 24px 18px 80px;">
    <p style="font-family: var(--font-body); font-size: var(--text-body); line-height: 1.65; color: var(--text-secondary); margin: 0 0 20px;">
      Your reading progress is stored locally in this browser. You can export a JSON snapshot, re-import it on another device, or clear everything on this device. Your progress leaves this device only if you turn on Angle Code sync. Our <a href="/privacy" style="color: var(--focus); text-decoration: underline; text-underline-offset: 2px;">privacy notice</a> explains what sync and notifications send.
    </p>
    <ReadingProgressPanel client:idle />
    <p style="font-family: var(--font-body); font-size: var(--text-xs); line-height: 1.5; color: var(--text-muted); margin: 20px 0 0;">
      <a href="/disclaimer" style="color: inherit;">Disclaimer</a> · <a href="/about" style="color: inherit;">How this works</a>
    </p>
  </main>
  <UtilityFooter current="/progress" />
</Base>
