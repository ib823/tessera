---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import UtilityHeader from '../components/UtilityHeader.astro';
import PlumbLineBoard from '../components/PlumbLineBoard.svelte';

// Built by scripts/build-leaderboard.mjs; GATED by scripts/audit-scoreboard.mjs.
// In production (badge withheld) the file on disk is REDACTED to counts only, so
// no provisional scores on living people are ever read into this page or shipped.
let board: any = null;
try {
  board = JSON.parse(readFileSync(join(process.cwd(), 'public/leaderboard.json'), 'utf8'));
} catch {
  board = null;
}
const showFull = !!board && board.redacted !== true && Array.isArray(board.entries);
const isPreview = showFull && board.biasAudited !== true; // full data, badge not yet granted = internal review
const counts = board?.counts ?? { total: 37, ranked: 0 };
---
<Base title="The Plumb Line — accountability index" noindex={true}>
  <UtilityHeader />
  {isPreview && (
    <div style="background:var(--amber-bg);border-bottom:1px solid var(--border-light);">
      <p style="max-width:1100px;margin:0 auto;padding:8px 16px;font-family:var(--font-body);font-size:var(--text-xs);color:var(--score-warning);line-height:1.5;">
        <strong>Internal preview (PLUMB_PREVIEW) — unpublished.</strong> Provisional single-coder drafts; no leader is ranked; badge withheld. The public build redacts this to counts only. Not an electoral endorsement.
      </p>
    </div>
  )}
  {showFull ? (
    <main style="padding-top:8px;"><PlumbLineBoard board={board} client:load /></main>
  ) : (
    <main style="max-width:680px;margin:0 auto;padding:40px 18px 80px;font-family:var(--font-body);">
      <h1 style="font-family:var(--font-display);font-size:var(--text-title-lg,2rem);font-weight:800;letter-spacing:-0.04em;color:var(--text-primary);margin:0 0 8px;">The Plumb Line</h1>
      <p style="font-size:var(--text-reading);line-height:1.55;color:var(--text-secondary);margin:0 0 20px;">A non-partisan accountability instrument for Malaysian leaders. It measures conduct and structure, not popularity — and it will not publish a rank it cannot yet defend.</p>

      <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px;">
        <div style="background:var(--card);border:1px solid var(--border-light);border-radius:var(--radius-md);padding:10px 14px;"><b style="font-family:var(--font-display);font-size:1.5rem;font-weight:800;color:var(--text-primary);">{counts.total}</b><div style="font-size:var(--text-micro);color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.06em;">subjects on file</div></div>
        <div style="background:var(--card);border:1px solid var(--border-light);border-radius:var(--radius-md);padding:10px 14px;"><b style="font-family:var(--font-display);font-size:1.5rem;font-weight:800;color:var(--score-warning);">{counts.ranked}</b><div style="font-size:var(--text-micro);color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.06em;">ranked</div></div>
        <div style="background:var(--amber-bg);border:1px solid var(--border-light);border-radius:var(--radius-md);padding:10px 14px;display:flex;align-items:center;"><span style="font-family:var(--font-display);font-size:var(--text-xs);font-weight:700;color:var(--score-warning);letter-spacing:0.06em;">BIAS-AUDITED BADGE · WITHHELD</span></div>
      </div>

      <div style="background:var(--card);border:1px solid var(--border-light);border-radius:var(--radius-lg);padding:18px;">
        <p style="font-size:var(--text-body);line-height:1.65;color:var(--text-secondary);margin:0 0 12px;"><strong style="color:var(--text-primary);">The board is in audit.</strong> Every subject is on file with cited data, but the conduct panel is a single-coder draft. A rank publishes only once an independent panel of coders has scored each item and two bias gates clear — inter-coder reliability and the partisan-signal test. Until then the badge is withheld, by design, and no scores are shown here.</p>
        <p style="font-size:var(--text-body);line-height:1.65;color:var(--text-secondary);margin:0;">A blank rank column is not an omission. It is the point.</p>
      </div>
    </main>
  )}
</Base>
