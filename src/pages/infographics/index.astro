---
import Base from '../../layouts/Base.astro';
import UtilityHeader from '../../components/UtilityHeader.astro';

// Data Graphics hub — standalone visual explainers, grouped in one place.
const items = [
  {
    href: '/infographics/tourism-state',
    kicker: 'DOSM · 2024',
    title: 'How tourism-dependent is each Malaysian state?',
    blurb:
      'Domestic tourism receipts as a share of state GDP — a geographic choropleth of all 16 states, with the full dataset, method, and sources.',
    img: '/infographics/tourism-state.png',
  },
  {
    href: '/plumb-line-report',
    kicker: 'ACCOUNTABILITY INDEX',
    title: 'The Plumb Line',
    blurb:
      "How Malaysia's leaders score on the public record — conduct and delivery on one fixed set of public-record tests, every figure cited, scoring checked for party bias.",
    img: null,
  },
];

const card =
  'display:block;background:var(--card);border:1px solid var(--border-light);border-radius:var(--radius-lg);overflow:hidden;text-decoration:none;margin-bottom:18px;';
---
<Base
  title="Data Graphics — The Fourth Angle"
  description="Standalone visual explainers from The Fourth Angle, built from primary data: state tourism dependency and the Plumb Line leader accountability index."
>
  <UtilityHeader />
  <main style="max-width:760px;margin:0 auto;padding:24px 18px 80px;">
    <p style="font-family:var(--font-display);font-size:var(--text-xs);font-weight:600;color:var(--text-tertiary);margin:0 0 12px 0;text-transform:uppercase;letter-spacing:0.1em;">Data Graphics</p>
    <h1 style="font-family:var(--font-display);font-size:var(--text-title-lg);font-weight:700;color:var(--text-primary);margin:0 0 10px 0;letter-spacing:-0.04em;line-height:1.04;">Data Graphics</h1>
    <p style="font-family:var(--font-body);font-size:var(--text-body);color:var(--text-tertiary);margin:0 0 28px 0;line-height:1.6;">Standalone visual explainers, each built from primary sources and traceable to the figures behind it.</p>

    {items.map((it) => (
      <a href={it.href} style={card}>
        {it.img && (
          <img
            src={it.img}
            alt={it.title}
            loading="lazy"
            style="display:block;width:100%;height:auto;border-bottom:1px solid var(--border-light);"
          />
        )}
        <div style="padding:18px 20px;">
          <span style="font-family:var(--font-display);font-size:var(--text-xs);font-weight:700;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.08em;">{it.kicker}</span>
          <h2 style="font-family:var(--font-display);font-size:var(--text-reading-lg);font-weight:700;color:var(--text-primary);margin:6px 0 8px 0;letter-spacing:-0.03em;">{it.title}</h2>
          <p style="font-family:var(--font-body);font-size:var(--text-body);line-height:1.6;color:var(--text-secondary);margin:0;">{it.blurb}</p>
          <span style="display:inline-block;margin-top:12px;font-family:var(--font-body);font-size:var(--text-ui);font-weight:700;color:var(--accent,#3b3b76);">View &rarr;</span>
        </div>
      </a>
    ))}
  </main>
</Base>
